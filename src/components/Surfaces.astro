---
import BrowserChrome from './BrowserChrome.astro';
import CodeWindow from './CodeWindow.astro';
import Admin from './mockups/Admin.astro';
import Storefront from './mockups/Storefront.astro';

const catalogHtml = `<span class="text-white/40">curl</span> http://localhost:3000/api/v1/catalog
<span class="text-emerald-300/90">{ "products": […], "total": 42, "page": 1 }</span>`;
---

<section id="surfaces" class="border-t border-hairline bg-canvas" aria-labelledby="surfaces-heading">
	<div class="mx-auto max-w-page px-4 py-band sm:px-6">
		<div class="max-w-copy">
			<p class="eyebrow">One app</p>
			<h2 id="surfaces-heading" class="mt-3 text-band font-medium text-pretty text-ink">
				Three surfaces. One process.
			</h2>
			<p class="mt-4 text-body text-mute">
				Themed storefront, merchant admin, and public/admin REST APIs live in a single React Router app.
				Domain logic sits in one place, so you can read it, change it, and ship it like any other Node
				service.
			</p>
			<p class="mt-3 text-body text-mute">
				Clone it, scaffold a shop in minutes, and own the stack end to end — no constellation of SaaS
				products to glue together.
			</p>
		</div>

		<div class="mt-14 grid items-start gap-6 lg:grid-cols-2">
			<BrowserChrome url="localhost:3000" label="storefront">
				<Storefront />
			</BrowserChrome>
			<div class="space-y-6">
				<BrowserChrome url="localhost:3000/admin" label="admin">
					<Admin />
				</BrowserChrome>
				<CodeWindow title="GET /api/v1/catalog" meta="storefront API" html={catalogHtml} />
			</div>
		</div>
	</div>
</section>
