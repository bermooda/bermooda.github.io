---
import CodeWindow from './CodeWindow.astro';

const localHtml = `<span class="text-accent">$</span> bermooda install --local --dir ./my-shop -y
<span class="text-white/40">✓</span> Downloaded app
<span class="text-white/40">✓</span> Installed dependencies
<span class="text-white/40">✓</span> SQLite ready · prisma/dev.db
<span class="text-white/40">✓</span> Admin · admin@example.com
<span class="text-white/40">✓</span> Store · Demo Shop
<span class="text-accent">$</span> cd my-shop && bermooda dev
<span class="text-emerald-300/90">Local  http://localhost:3000</span>
<span class="text-emerald-300/90">Admin  http://localhost:3000/admin</span>`;
---

<section id="local-first" class="border-t border-hairline bg-canvas" aria-labelledby="local-heading">
	<div class="mx-auto max-w-page px-4 py-band sm:px-6">
		<div class="grid min-w-0 items-start gap-12 lg:grid-cols-2">
			<div class="max-w-copy">
				<p class="eyebrow">Local first</p>
				<h2 id="local-heading" class="mt-3 text-band font-medium text-pretty text-ink">
					SQLite to start. Postgres when you mean it.
				</h2>
				<p class="mt-4 text-body text-mute">
					No Docker, no managed database, no waiting on a cloud dashboard. <code
						class="font-mono text-[0.95em] text-ink">bermooda install</code
					> scaffolds deps, env, SQLite, an admin user, and a store name.
				</p>
				<p class="mt-3 text-body text-mute">
					When you are ready to ship, point <code class="font-mono text-[0.95em] text-ink">DATABASE_URL</code> at
					PostgreSQL and run the same app. Plain Node or a Dockerfile, your choice.
				</p>
			</div>
			<CodeWindow title="bermooda install" meta="local" html={localHtml} />
		</div>
	</div>
</section>
