---
import CodeWindow from '../CodeWindow.astro';

const dryRunHtml = `<span class="text-accent">$</span> bermooda update --dry-run
{
  <span class="text-sky-300">"shopRoot"</span>: <span class="text-emerald-300">"/srv/shop"</span>,
  <span class="text-sky-300">"targetRef"</span>: <span class="text-emerald-300">"v0.14.0"</span>,
  <span class="text-sky-300">"strategy"</span>: <span class="text-emerald-300">"tarball-merge"</span>,
  <span class="text-sky-300">"previousRef"</span>: <span class="text-emerald-300">"bermooda@0.13.0"</span>
}
<span class="text-accent">$</span> bermooda update
<span class="text-emerald-300">✔</span> Tarball merge complete (412 paths, source v0.14.0)
<span class="text-emerald-300">✔</span> Database ready
<span class="text-emerald-300">✔</span> Shop updated to v0.14.0`;

const strategies = [
	{
		name: 'git-ff',
		when: 'Shop is a git checkout',
		body: 'Fetches tags and fast-forwards. If you changed core files, it stops and tells you instead of guessing.',
	},
	{
		name: 'tarball-merge',
		when: 'Plain directory',
		body: 'Downloads the release and merges core paths. Your themes, plugins, .env, and config stay put.',
	},
];
---

<section id="update" class="border-t border-hairline bg-canvas" aria-labelledby="update-heading">
	<div class="mx-auto max-w-page px-4 py-band sm:px-6">
		<div class="grid min-w-0 items-start gap-12 lg:grid-cols-2 lg:gap-16">
			<div class="max-w-copy">
				<p class="eyebrow">update</p>
				<h2 id="update-heading" class="mt-3 text-band font-medium text-pretty text-ink">
					Upgrades you can preview.
				</h2>
				<p class="mt-4 text-body text-mute">
					<code class="font-mono text-[0.95em] text-ink">bermooda update</code> pulls the latest release, reinstalls
					dependencies, and runs migrations. Add <code class="font-mono text-[0.95em] text-ink">--dry-run</code> to
					see the plan first, or <code class="font-mono text-[0.95em] text-ink">--ref</code> to pin a version.
				</p>

				<ul class="mt-8 space-y-4">
					{
						strategies.map((s) => (
							<li class="rounded-xl border border-hairline p-5">
								<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
									<code class="font-mono text-[13px] text-accent">{s.name}</code>
									<span class="text-[12px] font-semibold tracking-[0.075em] text-mute uppercase">{s.when}</span>
								</div>
								<p class="mt-2 text-sm text-mute">{s.body}</p>
							</li>
						))
					}
				</ul>
				<p class="mt-6 text-sm text-mute">
					The CLI keeps itself current too: <code class="font-mono text-[0.95em] text-ink">bermooda upgrade</code>.
				</p>
			</div>

			<CodeWindow title="update" meta="plan, then apply" html={dryRunHtml} />
		</div>
	</div>
</section>
