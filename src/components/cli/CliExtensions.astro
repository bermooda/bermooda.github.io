---
import CodeWindow from '../CodeWindow.astro';

const sourcesHtml = `<span class="text-white/40"># npm (default), optionally pinned</span>
<span class="text-accent">$</span> bermooda plugin add @bermooda/plugin-subscriptions 1.2.0

<span class="text-white/40"># a folder you are hacking on</span>
<span class="text-accent">$</span> bermooda theme add my-theme --path ./packages/my-theme

<span class="text-white/40"># a git ref or an HTTPS tarball</span>
<span class="text-accent">$</span> bermooda plugin add my-plugin --git https://github.com/org/plugin.git#v1
<span class="text-accent">$</span> bermooda plugin add my-plugin --tarball https://example.com/plugin.tgz`;

const manifestHtml = `{
  <span class="text-sky-300">"name"</span>: <span class="text-emerald-300">"@acme/bermooda-plugin-loyalty"</span>,
  <span class="text-sky-300">"bermooda"</span>: {
    <span class="text-sky-300">"id"</span>: <span class="text-emerald-300">"loyalty"</span>,
    <span class="text-sky-300">"engine"</span>: <span class="text-emerald-300">"&gt;=0.13.0"</span>
  }
}`;

const guarantees = [
	{
		title: 'Engine checked first',
		body: 'Each package declares a bermooda.engine semver range. Incompatible versions are rejected before anything is copied.',
	},
	{
		title: 'Scripts off by default',
		body: 'Extension dependencies install with --ignore-scripts. Opt specific packages in with BERMOODA_EXTENSION_INSTALL_SCRIPTS.',
	},
	{
		title: 'Backups on update',
		body: 'update copies the previous version to .bermooda/backups before replacing it, so a bad release is one move away from undone.',
	},
];
---

<section id="extensions" class="border-t border-hairline bg-canvas" aria-labelledby="extensions-heading">
	<div class="mx-auto max-w-page px-4 py-band sm:px-6">
		<div class="max-w-copy">
			<p class="eyebrow">theme · plugin</p>
			<h2 id="extensions-heading" class="mt-3 text-band font-medium text-pretty text-ink">
				Extensions from anywhere. Safely.
			</h2>
			<p class="mt-4 text-body text-mute">
				Themes land in <code class="font-mono text-[0.95em] text-ink">app/themes/*</code>, plugins in <code
					class="font-mono text-[0.95em] text-ink">app/plugins/*</code
				>. Both commands share one shape: <code class="font-mono text-[0.95em] text-ink">add</code>, <code
					class="font-mono text-[0.95em] text-ink">update</code
				>, <code class="font-mono text-[0.95em] text-ink">remove</code>, <code
					class="font-mono text-[0.95em] text-ink">list</code
				>.
			</p>
		</div>

		<div class="mt-14 grid min-w-0 items-start gap-6 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,0.75fr)]">
			<CodeWindow title="sources" meta="npm · path · git · tarball" html={sourcesHtml} />
			<CodeWindow title="package.json" html={manifestHtml} />
		</div>

		<ul class="mt-10 grid gap-8 sm:grid-cols-3">
			{
				guarantees.map((item) => (
					<li class="border-l-2 border-accent/30 pl-4">
						<p class="font-medium tracking-tight text-ink">{item.title}</p>
						<p class="mt-1.5 text-sm text-mute">{item.body}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
