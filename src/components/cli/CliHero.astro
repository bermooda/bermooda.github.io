---
import CliDemo from './CliDemo.astro';

const installCmd = 'npm i -g @bermooda/cli@latest';
---

<section class="relative overflow-hidden">
	<div class="relative mx-auto max-w-page px-4 pt-hero pb-20 sm:px-6 lg:pb-28">
		<p class="animate-fade-up eyebrow text-center">bermooda CLI</p>
		<h1
			class="animate-fade-up animation-delay-200 relative z-10 mx-auto mt-4 max-w-4xl text-center text-hero font-medium text-pretty text-ink"
		>
			From zero to shop in one command
		</h1>
		<p
			class="animate-fade-up animation-delay-400 relative z-10 mx-auto mt-5 max-w-copy text-center text-lg text-balance text-mute sm:text-xl"
		>
			<code class="font-mono text-[0.9em] text-ink">bermooda</code> installs, runs, updates, and extends your
			shop. Themes, plugins, and agent setup are commands, not chores.
		</p>

		<div class="relative pt-8">
			<div
				class="hero-grid pointer-events-none absolute inset-x-[calc(50%-50vw)] -top-24 bottom-0 w-screen overflow-hidden"
				aria-hidden="true"
			>
				<svg
					class="absolute top-1/2 left-1/2 size-[1800px] -translate-x-1/2 -translate-y-1/2 rotate-45 text-black/5"
					width="100%"
					height="100%"
				>
					<defs>
						<pattern id="cli-diamond-grid" x="-1" y="-1" width="40" height="40" patternUnits="userSpaceOnUse">
							<path d="M 40 0 L 0 0 0 40" fill="transparent" stroke="currentColor" stroke-width="1"></path>
						</pattern>
					</defs>
					<rect fill="url(#cli-diamond-grid)" width="100%" height="100%"></rect>
				</svg>
			</div>

			<div class="animate-fade-up animation-delay-400 relative z-10 flex flex-col items-center gap-4">
				<div
					class="flex h-12 w-full max-w-md min-w-0 items-center gap-3 rounded-lg border border-hairline bg-canvas pr-1.5 pl-4 shadow-control"
				>
					<span class="font-mono text-[13px] text-accent" aria-hidden="true">$</span>
					<code class="min-w-0 flex-1 truncate font-mono text-[13px] text-ink sm:text-sm">{installCmd}</code>
					<button
						type="button"
						class="copy-btn inline-flex h-9 shrink-0 items-center gap-1.5 rounded-md px-2.5 text-[13px] font-medium tracking-tight text-mute transition duration-100 hover:bg-soft hover:text-ink"
						data-copy={installCmd}
						aria-label="Copy install command"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							fill="none"
							viewBox="0 0 24 24"
							stroke-width="1.5"
							stroke="currentColor"
							class="size-4"
							aria-hidden="true"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75"
							></path>
						</svg>
						<span data-copy-label>Copy</span>
					</button>
				</div>
				<p class="font-mono text-[11px] text-mute">Node.js ≥ 24 · MIT licensed</p>
			</div>

			<div class="animate-fade-up animation-delay-400 relative z-10 mx-auto mt-14 w-full max-w-3xl min-w-0">
				<CliDemo />
			</div>
		</div>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((button) => {
		const label = button.querySelector('[data-copy-label]');
		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(button.dataset.copy ?? '');
				if (label) label.textContent = 'Copied';
			} catch {
				if (label) label.textContent = 'Copy failed';
			}
			window.setTimeout(() => {
				if (label) label.textContent = 'Copy';
			}, 1600);
		});
	});
</script>
