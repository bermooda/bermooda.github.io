---
import CodeWindow from '../CodeWindow.astro';

const localHtml = `<span class="text-white/40"># SQLite, sensible defaults, no prompts</span>
<span class="text-accent">$</span> bermooda install --local --dir ./my-shop -y \\
    --admin-email admin@example.com \\
    --store-name <span class="text-emerald-300">'Demo Shop'</span>`;

const serverHtml = `<span class="text-white/40"># PostgreSQL, your domain, demo catalog</span>
<span class="text-accent">$</span> bermooda install --server --dir /srv/shop -y \\
    --database-url <span class="text-emerald-300">"$DATABASE_URL"</span> \\
    --base-url https://shop.example.com \\
    --from-email <span class="text-emerald-300">'Shop &lt;orders@example.com&gt;'</span> \\
    --admin-email ops@example.com \\
    --admin-password <span class="text-emerald-300">"$ADMIN_PASSWORD"</span> \\
    --with-demo`;

const steps = [
	'Download the app from npm, a git ref, or a local checkout',
	'npm install',
	'Write .env and bermooda.config.js',
	'Generate Prisma client and run migrations',
	'Create the admin user and store',
	'Install the default theme and search plugin',
];

const flags = [
	{ flag: '--local / --server', detail: 'Install profile: SQLite or PostgreSQL defaults' },
	{ flag: '--dir <path>', detail: 'Target directory' },
	{ flag: '--ref <tag|branch>', detail: 'Install a specific app ref from GitHub' },
	{ flag: '--source <path>', detail: 'Use a local app checkout, no network' },
	{ flag: '--db, --database-url', detail: 'Pick the database and connection string' },
	{ flag: '--base-url, --from-email', detail: 'Public URL and transactional sender' },
	{ flag: '--skip-deps, --skip-db', detail: 'Skip npm install or migrate and seed' },
	{ flag: '--force, --force-env', detail: 'Allow a non-empty dir, overwrite .env' },
];
---

<section id="install" class="border-t border-hairline bg-canvas" aria-labelledby="install-heading">
	<div class="mx-auto max-w-page px-4 py-band sm:px-6">
		<div class="grid min-w-0 items-start gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-16">
			<div class="max-w-copy">
				<p class="eyebrow">install</p>
				<h2 id="install-heading" class="mt-3 text-band font-medium text-pretty text-ink">
					Laptop or server. Same command.
				</h2>
				<p class="mt-4 text-body text-mute">
					Run it bare and it asks what it needs. Pass <code class="font-mono text-[0.95em] text-ink">-y</code> and
					flags and it runs unattended, in CI or a provisioning script.
				</p>
				<ol class="mt-8 space-y-3">
					{
						steps.map((step, i) => (
							<li class="flex gap-4">
								<span class="pt-0.5 font-mono text-[12px] text-accent">{String(i + 1).padStart(2, '0')}</span>
								<p class="text-[15px] text-ink">{step}</p>
							</li>
						))
					}
				</ol>
			</div>

			<div class="min-w-0 space-y-6">
				<CodeWindow title="local" meta="SQLite" html={localHtml} />
				<CodeWindow title="server" meta="PostgreSQL" html={serverHtml} />
			</div>
		</div>

		<div class="mt-12 overflow-hidden rounded-xl border border-hairline bg-canvas shadow-control">
			<div class="border-b border-hairline px-4 py-2.5 font-mono text-[11px] text-mute">install flags</div>
			<ul class="grid gap-px bg-hairline md:grid-cols-2">
				{
					flags.map((row) => (
						<li class="grid gap-1 bg-canvas px-4 py-3 sm:grid-cols-[minmax(0,12.5rem)_1fr] sm:items-baseline sm:gap-4">
							<code class="font-mono text-[13px] text-ink">{row.flag}</code>
							<p class="text-sm text-mute">{row.detail}</p>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
