---
import CodeWindow from './CodeWindow.astro';

const deployHtml = `<span class="text-accent">$</span> npm run build
<span class="text-accent">$</span> bermooda start

<span class="text-white/40"># or</span>
<span class="text-accent">$</span> docker build -t bermooda .
<span class="text-accent">$</span> docker run -p 3000:3000 bermooda`;
---

<section id="deploy" class="border-t border-hairline bg-canvas" aria-labelledby="deploy-heading">
	<div class="mx-auto max-w-page px-4 py-band sm:px-6">
		<div class="grid min-w-0 items-start gap-12 lg:grid-cols-2">
			<div class="max-w-copy">
				<p class="eyebrow">Deploy</p>
				<h2 id="deploy-heading" class="mt-3 text-band font-medium text-pretty text-ink">
					Plain Node. Or a container. That’s it.
				</h2>
				<p class="mt-4 text-body text-mute">
					Production is <code class="font-mono text-[0.95em] text-ink">npm run build</code>
					then <code class="font-mono text-[0.95em] text-ink">bermooda start</code>. Output lands in
					<code class="font-mono text-[0.95em] text-ink">build/client</code>
					and <code class="font-mono text-[0.95em] text-ink">build/server</code>.
				</p>
				<p class="mt-3 text-body text-mute">
					A Dockerfile ships in the repo. Wire Postgres, Stripe, and object storage when you leave SQLite
					behind, not before.
				</p>
			</div>
			<CodeWindow title="production" meta="Node or Docker" html={deployHtml} />
		</div>
	</div>
</section>
