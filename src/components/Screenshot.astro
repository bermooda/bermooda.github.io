---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
	src: ImageMetadata;
	alt: string;
	sizes?: string;
	loading?: 'eager' | 'lazy';
}

const { src, alt, sizes = '(min-width: 1024px) 520px, 100vw', loading = 'lazy' } = Astro.props;
---

<Picture
	src={src}
	alt={alt}
	formats={['avif', 'webp']}
	fallbackFormat="webp"
	widths={[640, 960, 1280, 1600, 2400]}
	sizes={sizes}
	loading={loading}
	class="block h-auto w-full"
/>
