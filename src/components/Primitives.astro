---
import BrowserChrome from './BrowserChrome.astro';
import Checkout from './mockups/Checkout.astro';

const primitives = [
	'Catalog',
	'Cart',
	'Checkout',
	'Payments',
	'Shipping',
	'Customers',
	'Discounts',
	'Inventory',
	'Orders',
	'Reviews',
];
---

<section id="primitives" class="border-t border-hairline bg-canvas" aria-labelledby="primitives-heading">
	<div class="mx-auto max-w-page px-4 py-band sm:px-6">
		<div class="max-w-copy">
			<p class="eyebrow">Commerce primitives</p>
			<h2 id="primitives-heading" class="mt-3 text-band font-medium text-pretty text-ink">
				Real shop mechanics, not a demo cart.
			</h2>
			<p class="mt-4 text-body text-mute">
				Catalog, cart, checkout, payments, shipping, customers, discounts, and inventory — domain
				workflows under <code class="font-mono text-[0.95em] text-ink">app/core/*</code>, not scattered
				across services.
			</p>
			<p class="mt-3 text-body text-mute">
				Stripe for payments, better-auth for admin and customer sessions, Resend for mail. The engine is
				yours to extend.
			</p>
		</div>

		<ul class="mt-10 flex flex-wrap gap-2">
			{
				primitives.map((item) => (
					<li class="rounded-lg border border-hairline bg-canvas px-3 py-1.5 text-sm font-medium tracking-tight text-ink">
						{item}
					</li>
				))
			}
		</ul>

		<div class="mt-10">
			<BrowserChrome url="localhost:3000/checkout" label="checkout">
				<Checkout />
			</BrowserChrome>
		</div>
	</div>
</section>
