---
import CodeWindow from './CodeWindow.astro';

const treeHtml = `<span class="text-white/40">app/</span>
  <span class="text-accent">core/</span>       <span class="text-white/40"># catalog, cart, orders, payments</span>
  <span class="text-sky-300">libs/</span>       <span class="text-white/40"># auth, Prisma, queue, SDKs</span>
  <span class="text-violet-300">routes/</span>     <span class="text-white/40"># storefront, admin, API, webhooks</span>
  <span class="text-emerald-300">themes/</span>     <span class="text-white/40"># active theme renders the shop</span>
  <span class="text-amber-200">plugins/</span>    <span class="text-white/40"># hooks, blocks, providers</span>
  components/ <span class="text-white/40"># admin / auth / UI primitives</span>`;

const notes = [
	{
		title: 'Thin routes',
		body: 'Loaders and actions call app/core/*. Keep HTTP at the edge of the system.',
	},
	{
		title: 'Themes stay client-safe',
		body: 'Storefront UI receives data via props. Themes do not import server core modules.',
	},
	{
		title: 'Plugins register, they don’t fork',
		body: 'Hooks, providers, and optional admin or storefront UI, enabled without touching core.',
	},
];
---

<section id="architecture" class="border-t border-hairline bg-canvas" aria-labelledby="architecture-heading">
	<div class="mx-auto max-w-page px-4 py-band sm:px-6">
		<div class="max-w-copy">
			<p class="eyebrow">Architecture</p>
			<h2 id="architecture-heading" class="mt-3 text-band font-medium text-pretty text-ink">
				A Node app you can actually read.
			</h2>
			<p class="mt-4 text-body text-mute">
				bermooda is not a black-box platform with a theme layer glued on. Core workflows, routes, themes, and
				plugins sit in one repository with ordinary files.
			</p>
			<p class="mt-3 text-body text-mute">
				If you want a full shop you can fork, understand, and grow. This is the map.
			</p>
		</div>

		<div class="mt-14 grid min-w-0 items-start gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
			<CodeWindow title="app/" meta="repository" html={treeHtml} />
			<ul class="space-y-6">
				{
					notes.map((note) => (
						<li>
							<h3 class="font-medium tracking-tight text-ink">{note.title}</h3>
							<p class="mt-1 text-sm leading-relaxed text-mute">{note.body}</p>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
