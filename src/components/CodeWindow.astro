---
interface Props {
	title?: string;
	meta?: string;
	html: string;
}

const { title = 'terminal', meta, html } = Astro.props;
---

<div class="w-full min-w-0 overflow-hidden rounded-xl bg-ink-strong shadow-mock">
	<div class="flex items-center gap-2 border-b border-white/10 px-4 py-2.5">
		<span class="size-2.5 rounded-full bg-[#FF5F57]"></span>
		<span class="size-2.5 rounded-full bg-[#FEBC2E]"></span>
		<span class="size-2.5 rounded-full bg-[#28C840]"></span>
		<span class="ml-2 font-mono text-[11px] text-white/45">{title}</span>
		{meta ? <span class="ml-auto font-mono text-[11px] text-white/35">{meta}</span> : null}
	</div>
	<pre class="overflow-x-auto p-4 font-mono text-[13px] leading-relaxed text-white/90 sm:text-sm"><code set:html={html}></code></pre>
</div>
