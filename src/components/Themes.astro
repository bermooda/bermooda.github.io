---
import BrowserChrome from './BrowserChrome.astro';
import CodeWindow from './CodeWindow.astro';
import ThemesAdmin from './mockups/ThemesAdmin.astro';

const pluginHtml = `<span class="text-violet-300">export default</span> definePlugin({
  hooks: {
    <span class="text-sky-300">'catalog.search'</span>: <span class="text-violet-300">async</span> (ctx, query) => {
      <span class="text-white/40">// replace storefront search</span>
      <span class="text-violet-300">return</span> searchIndex(query)
    },
  },
})`;
---

<section id="themes" class="border-t border-hairline bg-canvas" aria-labelledby="themes-heading">
	<div class="mx-auto max-w-page px-4 py-band sm:px-6">
		<div class="max-w-copy">
			<p class="eyebrow">Themes & plugins</p>
			<h2 id="themes-heading" class="mt-3 text-band font-medium text-pretty text-ink">
				Swap the storefront. Hook the engine.
			</h2>
			<p class="mt-4 text-body text-mute">
				Themes live under <code class="font-mono text-[0.95em] text-ink">app/themes/*</code> and own the
				shop UI. Plugins under <code class="font-mono text-[0.95em] text-ink">app/plugins/*</code> register
				hooks, providers, and optional admin pages, without forking core.
			</p>
			<p class="mt-3 text-body text-mute">
				Activate a theme or toggle a plugin in admin. The CLI can add, update, and remove both.
			</p>
		</div>

		<div class="mt-14 grid min-w-0 items-start gap-6 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)]">
			<BrowserChrome url="localhost:3000/admin/themes" label="admin">
				<ThemesAdmin />
			</BrowserChrome>
			<CodeWindow title="app/plugins/meilisearch/index.server.js" html={pluginHtml} />
		</div>
	</div>
</section>
