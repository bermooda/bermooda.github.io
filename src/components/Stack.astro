---
const stack = [
	'React Router',
	'React 19',
	'Prisma',
	'SQLite',
	'PostgreSQL',
	'Stripe',
	'better-auth',
	'Vite',
	'Tailwind CSS',
	'Nodemailer',
];
---

<section class="border-t border-hairline bg-canvas" aria-labelledby="stack-heading">
	<div class="mx-auto max-w-page px-4 py-20 sm:px-6">
		<p class="eyebrow text-center">Stack</p>
		<h2 id="stack-heading" class="mt-3 text-center text-band font-medium tracking-tight text-ink">
			Familiar tools, one service.
		</h2>
		<p class="mx-auto mt-3 max-w-copy text-center text-mute">
			Node.js ≥ 24. Vitest, oxlint, and oxfmt in the repo. Deploy as plain Node or Docker.
		</p>
		<ul class="mt-12 flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
			{
				stack.map((item) => (
					<li class="text-sm font-medium tracking-tight text-mute">{item}</li>
				))
			}
		</ul>
	</div>
</section>
