---
import CodeWindow from './CodeWindow.astro';

const cartHtml = `<span class="text-violet-300">const</span> res = <span class="text-violet-300">await</span> fetch(<span class="text-emerald-300">'/api/v1/cart'</span>, {
  method: <span class="text-emerald-300">'POST'</span>,
  headers: { <span class="text-sky-300">'Content-Type'</span>: <span class="text-emerald-300">'application/json'</span> },
  body: JSON.stringify({ currency: <span class="text-emerald-300">'USD'</span> })
})
<span class="text-violet-300">const</span> { cart } = <span class="text-violet-300">await</span> res.json()
<span class="text-white/40">// cart.token gates later cart calls</span>`;

const endpoints = [
	{ method: 'GET', path: '/api/v1/catalog', note: 'Published products' },
	{ method: 'POST', path: '/api/v1/cart', note: 'Create a cart' },
	{ method: 'POST', path: '/api/v1/checkout', note: 'Start checkout' },
	{ method: 'GET', path: '/api/admin/v1/orders', note: 'Bearer berm_…' },
];
---

<section id="api" class="border-t border-hairline bg-canvas" aria-labelledby="api-heading">
	<div class="mx-auto max-w-page px-4 py-band sm:px-6">
		<div class="max-w-copy">
			<p class="eyebrow">REST API</p>
			<h2 id="api-heading" class="mt-3 text-band font-medium text-pretty text-ink">
				Storefront is public. Admin is keyed.
			</h2>
			<p class="mt-4 text-body text-mute">
				<code class="font-mono text-[0.95em] text-ink">/api/v1</code> covers catalog, search, cart, and
				checkout, with no API key. Carts are gated by the token returned at create.
			</p>
			<p class="mt-3 text-body text-mute">
				<code class="font-mono text-[0.95em] text-ink">/api/admin/v1</code> uses <code
					class="font-mono text-[0.95em] text-ink">Authorization: Bearer berm_…</code
				> with scopes. Same domain logic as the admin UI, built for agents and your own tools.
			</p>
		</div>

		<div class="mt-14 grid min-w-0 items-start gap-6 lg:grid-cols-2">
			<div class="overflow-hidden rounded-xl border border-hairline bg-canvas shadow-control">
				<div class="border-b border-hairline px-4 py-2.5 font-mono text-[11px] text-mute">routes</div>
				<ul class="divide-y divide-hairline">
					{
						endpoints.map((row) => (
							<li class="flex items-baseline gap-3 px-4 py-3 font-mono text-[13px]">
								<span class="w-12 shrink-0 text-accent">{row.method}</span>
								<span class="min-w-0 truncate text-ink">{row.path}</span>
								<span class="ml-auto hidden shrink-0 text-[12px] text-mute sm:inline">{row.note}</span>
							</li>
						))
					}
				</ul>
			</div>
			<CodeWindow title="create a cart" meta="POST /api/v1/cart" html={cartHtml} />
		</div>
	</div>
</section>
