---
import { DOCS_URL } from '../consts';
import CodeWindow from './CodeWindow.astro';

const quickStartHtml = `<span class="text-white/40"># Install the CLI</span>
<span class="text-accent">$</span> npm i -g @bermooda/cli@latest

<span class="text-white/40"># Scaffold a local shop</span>
<span class="text-accent">$</span> bermooda install --local --dir ./my-shop -y

<span class="text-white/40"># Run it</span>
<span class="text-accent">$</span> cd my-shop
<span class="text-accent">$</span> bermooda dev`;

const steps = [
	{ n: '01', title: 'Install the CLI', body: 'Requires Node.js ≥ 24. The bermooda binary is then available globally.' },
	{ n: '02', title: 'Scaffold a shop', body: 'install --local writes deps, env, SQLite, an admin user, and the store name.' },
	{ n: '03', title: 'Run the app', body: 'bermooda dev starts the storefront, admin, and API on localhost:3000.' },
];
---

<section id="get-started" class="border-t border-hairline bg-canvas" aria-labelledby="get-started-heading">
	<div class="mx-auto max-w-page px-4 py-band sm:px-6">
		<div class="grid min-w-0 items-start gap-12 lg:grid-cols-2 lg:gap-16">
			<div>
				<p class="eyebrow">Get started</p>
				<h2 id="get-started-heading" class="mt-3 text-band font-medium text-pretty text-ink">
					Scaffold a shop in minutes
				</h2>
				<p class="mt-4 max-w-copy text-body text-mute">
					Install the CLI, create a local shop, and run the dev server. Full flags and setup notes live in
					the docs.
				</p>
				<ol class="mt-8 space-y-5">
					{
						steps.map((step) => (
							<li class="flex gap-4">
								<span class="font-mono text-[12px] text-accent pt-0.5">{step.n}</span>
								<div>
									<p class="font-medium tracking-tight text-ink">{step.title}</p>
									<p class="mt-1 text-sm text-mute">{step.body}</p>
								</div>
							</li>
						))
					}
				</ol>
				<a
					href={`${DOCS_URL}/getting-started`}
					class="mt-8 inline-flex text-[15px] font-medium tracking-tight text-accent transition duration-100 hover:text-accent-hover"
				>
					Read the docs →
				</a>
			</div>

			<CodeWindow title="quick start" meta="recommended" html={quickStartHtml} />
		</div>
	</div>
</section>
