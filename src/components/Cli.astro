---
const commands = [
	{ cmd: 'bermooda install', detail: 'Download the app, install deps, configure env & DB, create admin + store' },
	{ cmd: 'bermooda dev', detail: 'Start the local server on port 3000' },
	{ cmd: 'bermooda start', detail: 'Run the production server (builds if needed)' },
	{ cmd: 'bermooda update', detail: 'Update the shop to the latest app version' },
	{ cmd: 'bermooda theme …', detail: 'Add, update, remove, or list themes' },
	{ cmd: 'bermooda plugin …', detail: 'Add, update, remove, or list plugins' },
];
---

<section id="cli" class="border-t border-hairline bg-canvas" aria-labelledby="cli-heading">
	<div class="mx-auto max-w-page px-4 py-band sm:px-6">
		<div class="max-w-copy">
			<p class="eyebrow">CLI</p>
			<h2 id="cli-heading" class="mt-3 text-band font-medium text-pretty text-ink">
				The binary is the onboarding.
			</h2>
			<p class="mt-4 text-body text-mute">
				<code class="font-mono text-[0.95em] text-ink">bermooda install</code> is the recommended path — local
				or server. It does the boring work so you can open the shop.
			</p>
			<p class="mt-3 text-body text-mute">
				Themes and plugins are first-class commands, not afterthoughts. <code
					class="font-mono text-[0.95em] text-ink">bermooda help</code
				> is built in.
			</p>
		</div>

		<div class="mt-12 overflow-hidden rounded-xl border border-hairline bg-canvas shadow-control">
			<div class="border-b border-hairline px-4 py-2.5 font-mono text-[11px] text-mute">@bermooda/cli</div>
			<ul class="divide-y divide-hairline">
				{
					commands.map((row) => (
						<li class="grid gap-1 px-4 py-3 sm:grid-cols-[minmax(0,14rem)_1fr] sm:items-baseline sm:gap-6">
							<code class="font-mono text-[13px] text-ink">
								<span class="text-accent">$</span> {row.cmd}
							</code>
							<p class="text-sm text-mute">{row.detail}</p>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
