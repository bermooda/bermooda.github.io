---
import CodeWindow from '../CodeWindow.astro';

const configHtml = `{
  <span class="text-sky-300">"mcpServers"</span>: {
    <span class="text-sky-300">"bermooda"</span>: {
      <span class="text-sky-300">"command"</span>: <span class="text-emerald-300">"npx"</span>,
      <span class="text-sky-300">"args"</span>: [<span class="text-emerald-300">"-y"</span>, <span class="text-emerald-300">"@bermooda/mcp"</span>],
      <span class="text-sky-300">"env"</span>: {
        <span class="text-sky-300">"BERMOODA_URL"</span>: <span class="text-emerald-300">"http://localhost:3000"</span>,
        <span class="text-sky-300">"BERMOODA_API_KEY"</span>: <span class="text-emerald-300">"berm_…"</span>
      }
    }
  }
}`;

const initHtml = `<span class="text-white/40"># from your shop directory</span>
<span class="text-accent">$</span> bermooda mcp init
<span class="text-emerald-300">✔</span> Wrote MCP config to ~/my-shop/.cursor/mcp.json`;

const steps = [
	'Install a shop with bermooda install',
	'Run bermooda mcp init, or paste the config block',
	'Restart Cursor or Claude Desktop',
	'Ask the agent to call ping',
];

const env = [
	{ name: 'BERMOODA_URL', detail: 'Shop origin, e.g. http://localhost:3000' },
	{ name: 'BERMOODA_API_KEY', detail: 'Admin API key, starts with berm_' },
	{ name: 'PORT', detail: 'HTTP transport listen port (default 8787)' },
];
---

<section id="connect" class="border-t border-hairline bg-canvas" aria-labelledby="connect-heading">
	<div class="mx-auto max-w-page px-4 py-band sm:px-6">
		<div class="grid min-w-0 items-start gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-16">
			<div class="max-w-copy">
				<p class="eyebrow">Connect</p>
				<h2 id="connect-heading" class="mt-3 text-band font-medium text-pretty text-ink">
					One config block. Any client.
				</h2>
				<p class="mt-4 text-body text-mute">
					The server needs two things: where your shop lives and a <code
						class="font-mono text-[0.95em] text-ink">berm_</code
					> key. The CLI writes both for Cursor. Claude Desktop and other clients take the same block.
				</p>
				<ol class="mt-8 space-y-3">
					{
						steps.map((step, i) => (
							<li class="flex gap-4">
								<span class="pt-0.5 font-mono text-[12px] text-accent">{String(i + 1).padStart(2, '0')}</span>
								<p class="text-[15px] text-ink">{step}</p>
							</li>
						))
					}
				</ol>
			</div>

			<div class="min-w-0 space-y-6">
				<CodeWindow title="mcp.json" meta="Cursor · Claude Desktop" html={configHtml} />
				<CodeWindow title="terminal" meta="@bermooda/cli" html={initHtml} />
			</div>
		</div>

		<div class="mt-12 overflow-hidden rounded-xl border border-hairline bg-canvas shadow-control">
			<div class="border-b border-hairline px-4 py-2.5 font-mono text-[11px] text-mute">environment</div>
			<ul class="grid gap-px bg-hairline md:grid-cols-3">
				{
					env.map((row) => (
						<li class="grid gap-1 bg-canvas px-4 py-3">
							<code class="font-mono text-[13px] text-ink">{row.name}</code>
							<p class="text-sm text-mute">{row.detail}</p>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
