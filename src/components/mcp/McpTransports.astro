---
import CodeWindow from '../CodeWindow.astro';

const httpHtml = `<span class="text-white/40"># for cloud agents that can't spawn a local process</span>
<span class="text-accent">$</span> BERMOODA_URL=https://shop.example.com \\
  BERMOODA_API_KEY=berm_… npm run start:http
<span class="text-white/40"># listening on http://0.0.0.0:8787/mcp</span>

<span class="text-accent">$</span> curl http://localhost:8787/health
{ <span class="text-sky-300">"ok"</span>: true, <span class="text-sky-300">"name"</span>: <span class="text-emerald-300">"@bermooda/mcp"</span>, <span class="text-sky-300">"version"</span>: <span class="text-emerald-300">"0.1.0"</span> }`;

const transports = [
	{
		name: 'stdio',
		when: 'Default',
		body: 'Your client spawns the server with npx. Credentials live in the client config and never leave your machine.',
	},
	{
		name: 'Streamable HTTP',
		when: 'Hosted',
		body: 'POST /mcp, stateless, one session per request. The key stays in the server process, not in each request.',
	},
];

const layers = [
	{ label: 'Cursor · Claude', detail: 'native tools' },
	{ label: '@bermooda/mcp', detail: 'HTTP Bearer berm_ key' },
	{ label: '/api/admin/v1', detail: 'app/core' },
];
---

<section id="transports" class="border-t border-hairline bg-canvas" aria-labelledby="transports-heading">
	<div class="mx-auto max-w-page px-4 py-band sm:px-6">
		<div class="grid min-w-0 items-start gap-12 lg:grid-cols-2 lg:gap-16">
			<div class="order-2 min-w-0 lg:order-1">
				<CodeWindow title="http" meta="PORT=8787" html={httpHtml} />
			</div>
			<div class="order-1 max-w-copy lg:order-2">
				<p class="eyebrow">Transports</p>
				<h2 id="transports-heading" class="mt-3 text-band font-medium text-pretty text-ink">
					Local by default. Hosted when you need it.
				</h2>
				<p class="mt-4 text-body text-mute">
					Run it next to your editor over stdio, or start the Streamable HTTP server for agents that live in
					the cloud. Same tools either way.
				</p>
				<ul class="mt-8 space-y-4">
					{
						transports.map((t) => (
							<li class="rounded-xl border border-hairline p-5">
								<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
									<code class="font-mono text-[13px] text-accent">{t.name}</code>
									<span class="text-[12px] font-semibold tracking-[0.075em] text-mute uppercase">{t.when}</span>
								</div>
								<p class="mt-2 text-sm text-mute">{t.body}</p>
							</li>
						))
					}
				</ul>
			</div>
		</div>

		<div class="mt-20 grid min-w-0 items-start gap-12 lg:grid-cols-2 lg:gap-16">
			<div class="max-w-copy">
				<p class="eyebrow">Architecture</p>
				<h3 class="mt-3 text-band font-medium text-pretty text-ink">A thin layer. No side doors.</h3>
				<p class="mt-4 text-body text-mute">
					The server holds no domain logic and never touches the database. It calls the same Admin API as the
					admin UI, with the same scopes, so what an agent can do is exactly what its key allows.
				</p>
			</div>
			<div class="overflow-hidden rounded-xl border border-hairline bg-canvas shadow-control">
				<div class="border-b border-hairline px-4 py-2.5 font-mono text-[11px] text-mute">request path</div>
				<ol class="grid gap-px bg-hairline sm:grid-cols-3">
					{
						layers.map((layer, i) => (
							<li class="bg-canvas px-4 py-3">
								<span class="font-mono text-[12px] text-accent">{String(i + 1).padStart(2, '0')}</span>
								<code class="mt-1 block font-mono text-[15px] text-ink">{layer.label}</code>
								<p class="mt-0.5 text-sm text-mute">{layer.detail}</p>
							</li>
						))
					}
				</ol>
			</div>
		</div>
	</div>
</section>
