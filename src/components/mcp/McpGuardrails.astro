---
import CodeWindow from '../CodeWindow.astro';

const html = `<span class="text-sky-300">⏺</span> setup_shop<span class="text-white/50">(dryRun: true)</span>
{
  <span class="text-sky-300">"settingsSections"</span>: [<span class="text-emerald-300">"general"</span>, <span class="text-emerald-300">"currencies"</span>, <span class="text-emerald-300">"shipping"</span>],
  <span class="text-sky-300">"categoriesCount"</span>: 2,
  <span class="text-sky-300">"productsCount"</span>: 6,
  <span class="text-sky-300">"themeId"</span>: <span class="text-emerald-300">"default"</span>
}
<span class="text-sky-300">⏺</span> delete_product<span class="text-white/50">(id: "prod_8f2k")</span>
<span class="text-amber-300">!</span> Refusing delete product prod_8f2k: pass confirm=true
<span class="text-sky-300">⏺</span> delete_product<span class="text-white/50">(id: "prod_8f2k", confirm: true)</span>
<span class="text-emerald-300">✔</span> Deleted`;

const rules = [
	{
		name: 'dryRun',
		when: 'Bulk changes',
		body: 'setup_shop returns its plan and import_products_csv checks the CSV first. Nothing is written until the agent comes back with confirm.',
	},
	{
		name: 'confirm',
		when: 'Destructive calls',
		body: 'Deletes, cancellations, refunds, disabling plugins, and uploads refuse to run without an explicit confirm=true.',
	},
	{
		name: 'scopes',
		when: 'API key',
		body: 'Keys carry granular scopes like products:write, with admin as a super-scope. Every mutation is audited as api_key.',
	},
];
---

<section id="guardrails" class="border-t border-hairline bg-canvas" aria-labelledby="guardrails-heading">
	<div class="mx-auto max-w-page px-4 py-band sm:px-6">
		<div class="grid min-w-0 items-start gap-12 lg:grid-cols-2 lg:gap-16">
			<div class="max-w-copy">
				<p class="eyebrow">Guardrails</p>
				<h2 id="guardrails-heading" class="mt-3 text-band font-medium text-pretty text-ink">
					Plan first. Confirm to commit.
				</h2>
				<p class="mt-4 text-body text-mute">
					Agents are fast and occasionally wrong. Tools that change a lot show their plan, and tools that
					can't be undone ask twice.
				</p>

				<ul class="mt-8 space-y-4">
					{
						rules.map((rule) => (
							<li class="rounded-xl border border-hairline p-5">
								<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
									<code class="font-mono text-[13px] text-accent">{rule.name}</code>
									<span class="text-[12px] font-semibold tracking-[0.075em] text-mute uppercase">{rule.when}</span>
								</div>
								<p class="mt-2 text-sm text-mute">{rule.body}</p>
							</li>
						))
					}
				</ul>
			</div>

			<CodeWindow title="agent" meta="plan, then apply" html={html} />
		</div>
	</div>
</section>
