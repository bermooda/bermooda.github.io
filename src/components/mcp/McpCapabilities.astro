---
const capabilities = [
	{
		tools: 'ping · setup_shop',
		title: 'Stand up a store',
		body: 'Verify the connection, then set name, currencies, shipping, categories, products, and theme in one planned call.',
	},
	{
		tools: 'get_settings · update_settings',
		title: 'Tune settings',
		body: 'Read the full settings snapshot or patch one section: general, currencies, locales, tax, shipping, SEO.',
	},
	{
		tools: 'upsert_product · import_products_csv',
		title: 'Run the catalog',
		body: 'List, create, update, and delete products and categories, or bulk import a CSV after a local dry run.',
	},
	{
		tools: 'list_orders · update_order_status',
		title: 'Work the orders',
		body: 'Page through orders, open one, and move it along. Cancelling or refunding asks for confirmation.',
	},
	{
		tools: 'activate_theme · update_plugins',
		title: 'Shape the storefront',
		body: 'List installed themes and plugins, switch the active theme, and enable, reorder, or configure plugins.',
	},
	{
		tools: 'get_overview_kpis · get_top_products',
		title: 'Read the numbers',
		body: 'Revenue, AOV, conversion, top products, customers, low stock, and export health for any date range.',
	},
];
---

<section id="capabilities" class="border-t border-hairline bg-canvas" aria-labelledby="capabilities-heading">
	<div class="mx-auto max-w-page px-4 py-band sm:px-6">
		<div class="max-w-copy">
			<p class="eyebrow">What it does</p>
			<h2 id="capabilities-heading" class="mt-3 text-band font-medium text-pretty text-ink">
				The admin, in your agent's hands.
			</h2>
			<p class="mt-4 text-body text-mute">
				Tools are grouped by intent, not one per route. An agent can set up a shop, keep the catalog current,
				and answer "how did we do last week" without you opening the admin or writing a line against the{' '}
				<a href="/docs/api" class="text-ink underline decoration-hairline underline-offset-4 hover:decoration-accent"
					>Admin REST API</a
				>.
			</p>
		</div>

		<ul class="mt-12 grid gap-px overflow-hidden rounded-xl border border-hairline bg-hairline sm:grid-cols-2 lg:grid-cols-3">
			{
				capabilities.map((item) => (
					<li class="flex flex-col bg-canvas p-6 transition duration-150 hover:bg-soft">
						<code class="font-mono text-[12px] text-accent">{item.tools}</code>
						<p class="mt-3 text-lg font-medium tracking-tight text-ink">{item.title}</p>
						<p class="mt-1.5 text-sm text-mute">{item.body}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
