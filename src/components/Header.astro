---
import { DOCS_URL, GITHUB_URL } from '../consts';
---

<header
	id="site-header"
	class="sticky top-0 z-50 border-b border-hairline bg-canvas/80 backdrop-blur-sm"
>
	<nav class="mx-auto flex h-nav max-w-page items-center justify-between gap-4 px-4 sm:px-6">
		<a href="/" class="flex shrink-0 items-center" aria-label="bermooda home">
			<img src="/logo-full.svg" alt="bermooda" class="h-5 w-auto" width="140" height="21" />
		</a>

		<div class="hidden items-center gap-1 md:flex">
			<a
				href={DOCS_URL}
				class="rounded-lg px-3 py-1.5 text-[15px] font-medium tracking-tight text-ink transition duration-100 hover:bg-accent/5"
				target="_blank"
				rel="noopener noreferrer">Docs</a
			>
			<a
				href={GITHUB_URL}
				class="rounded-lg px-3 py-1.5 text-[15px] font-medium tracking-tight text-ink transition duration-100 hover:bg-accent/5"
				target="_blank"
				rel="noopener noreferrer"
			>
				GitHub
			</a>
		</div>

		<a href="/#get-started" class="btn btn-primary h-10 px-4 text-sm sm:h-10"> Get Started </a>
	</nav>
</header>
