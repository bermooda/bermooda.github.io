---
import { GITHUB_URL } from '../consts';
import BrowserChrome from './BrowserChrome.astro';
import CodeWindow from './CodeWindow.astro';
import Admin from './mockups/Admin.astro';
import Storefront from './mockups/Storefront.astro';

const installHtml = `<span class="text-accent">$</span> npm i -g @bermooda/cli@latest
<span class="text-accent">$</span> bermooda install --local --dir ./my-shop -y
<span class="text-white/40"># storefront, admin, and API in one process</span>`;
---

<section class="relative overflow-hidden">
	<div class="relative mx-auto max-w-page px-4 pt-hero pb-20 sm:px-6 lg:pb-28">
		<p class="animate-fade-up eyebrow text-center">Open source · one deployable app</p>
		<h1
			class="animate-fade-up animation-delay-200 relative z-10 mx-auto mt-4 max-w-4xl text-center text-hero font-medium text-pretty text-ink"
		>
			Own your ecommerce stack
		</h1>
		<p
			class="animate-fade-up animation-delay-400 relative z-10 mx-auto mt-5 max-w-copy text-center text-lg text-balance text-mute sm:text-xl"
		>
			Open-source ecommerce as one deployable app, with a themed storefront, merchant admin, and REST API.
		</p>

		<div class="relative mt-8">
			<div
				class="hero-grid pointer-events-none absolute inset-x-[calc(50%-50vw)] bottom-full h-36 w-screen overflow-hidden sm:h-44"
				aria-hidden="true"
			>
				<svg
					class="absolute top-1/2 left-1/2 size-[1800px] -translate-x-1/2 -translate-y-1/2 rotate-45 text-black/10"
					width="100%"
					height="100%"
				>
					<defs>
						<pattern id="hero-diamond-grid" x="-1" y="-1" width="40" height="40" patternUnits="userSpaceOnUse">
							<path d="M 40 0 L 0 0 0 40" fill="transparent" stroke="currentColor" stroke-width="1"></path>
						</pattern>
					</defs>
					<rect fill="url(#hero-diamond-grid)" width="100%" height="100%"></rect>
				</svg>
			</div>

			<div class="animate-fade-up animation-delay-400 relative z-10 flex flex-wrap items-center justify-center gap-3">
				<a href="#get-started" class="btn btn-primary"> Get Started </a>
				<a href={GITHUB_URL} class="btn btn-secondary" target="_blank" rel="noopener noreferrer"> GitHub </a>
			</div>
		</div>

		<div class="animate-fade-up animation-delay-400 relative mx-auto mt-16 w-full min-w-0 max-w-5xl">
			<div class="grid min-w-0 items-start gap-6 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)]">
				<BrowserChrome url="localhost:3000" label="storefront">
					<Storefront />
				</BrowserChrome>
				<div class="min-w-0 space-y-6 lg:mt-10">
					<BrowserChrome url="localhost:3000/admin/orders" label="admin">
						<Admin />
					</BrowserChrome>
					<CodeWindow title="terminal" meta="Node.js ≥ 24" html={installHtml} />
				</div>
			</div>
		</div>
	</div>
</section>
