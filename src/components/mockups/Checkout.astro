---
const lines = [
	{ name: 'Ceramic pour-over', qty: 1, price: '$48' },
	{ name: 'Linen throw', qty: 1, price: '$89' },
];
---

<div class="grid gap-0 text-[12px] leading-snug text-ink sm:grid-cols-[1.1fr_0.9fr]">
	<div class="border-b border-hairline p-4 sm:border-r sm:border-b-0">
		<p class="font-medium tracking-tight">Checkout</p>
		<p class="mt-0.5 text-mute">Shipping · Payment</p>
		<div class="mt-4 space-y-3">
			<label class="block">
				<span class="text-[10px] text-mute">Email</span>
				<div class="mt-1 rounded-md border border-hairline bg-canvas px-2.5 py-1.5 text-ink">maya@cove.shop</div>
			</label>
			<div class="grid grid-cols-2 gap-2">
				<label class="block">
					<span class="text-[10px] text-mute">City</span>
					<div class="mt-1 rounded-md border border-hairline px-2.5 py-1.5">Lisbon</div>
				</label>
				<label class="block">
					<span class="text-[10px] text-mute">Country</span>
					<div class="mt-1 rounded-md border border-hairline px-2.5 py-1.5">Portugal</div>
				</label>
			</div>
			<div class="rounded-md border border-accent bg-accent-faded/50 px-2.5 py-2">
				<p class="font-medium">Standard · $8</p>
				<p class="text-mute">3–5 business days</p>
			</div>
			<div class="rounded-md border border-hairline px-2.5 py-2 text-mute">Express · $18</div>
		</div>
	</div>
	<div class="bg-soft p-4">
		<p class="font-medium tracking-tight">Cart</p>
		<ul class="mt-3 space-y-2">
			{
				lines.map((line) => (
					<li class="flex items-center justify-between gap-2">
						<span>
							{line.name}
							<span class="text-mute"> × {line.qty}</span>
						</span>
						<span class="tabular-nums">{line.price}</span>
					</li>
				))
			}
		</ul>
		<div class="mt-4 space-y-1 border-t border-hairline pt-3">
			<div class="flex justify-between text-mute">
				<span>Subtotal</span>
				<span class="tabular-nums">$137</span>
			</div>
			<div class="flex justify-between text-mute">
				<span>Shipping</span>
				<span class="tabular-nums">$8</span>
			</div>
			<div class="flex justify-between font-medium">
				<span>Total</span>
				<span class="tabular-nums">$145</span>
			</div>
		</div>
		<div class="mt-4 rounded-md bg-accent py-2 text-center text-[11px] font-medium text-white">Pay with Stripe</div>
	</div>
</div>
